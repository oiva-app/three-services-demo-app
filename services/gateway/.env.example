# Required: Honeycomb ingest API key (env-scoped)
HONEYCOMB_API_KEY=                                                            
                                                                            
# Required: where the orders service is reachable                             
ORDERS_URL=http://localhost:3002                                            
                                                                                                                       
                                                                            
# Optional: HTTP listen port (default: 3000)                                
# PORT=3000                                                    
                                                                            
# Optional: OTel overrides (defaults work for Honeycomb)                      
# OTEL_SERVICE_NAME=gateway
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.honeycomb.io/v1/traces       
                                          